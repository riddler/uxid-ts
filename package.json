{
  "name": "uxid",
  "version": "0.0.1",
  "description": "Prefixed, K-sortable identifiers a person can read, wire-compatible with the Elixir uxid package and checked against its conformance corpus.",
  "license": "MIT",
  "author": "JohnnyT <ubergeek3141@gmail.com>",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.4.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riddler/uxid-ts.git"
  },
  "bugs": {
    "url": "https://github.com/riddler/uxid-ts/issues"
  },
  "homepage": "https://github.com/riddler/uxid-ts#readme",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "gate": "node --version && pnpm run typecheck && pnpm run lint && pnpm run neutrality && vitest run --coverage && pnpm run build && pnpm run docs",
    "gate:loop": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "build": "tsup",
    "docs": "typedoc",
    "neutrality": "node scripts/engine-neutrality.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "24.13.4",
    "@vitest/coverage-v8": "5.0.1",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typedoc": "0.28.20",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
