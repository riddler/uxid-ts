# Custom files

# Compiled source
*.com
*.class
*.dll
*.exe
*.o
*.so

# Packages
#
# It's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Logs and databases
*.log
*.sql
*.sqlite

# OS generated files #
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor-made files
*.swp

#===== Ruby =====
*.gem
reports/

#===== Node/NPM/TypeScript =====
.cache
dist/

# The directory NPM downloads your dependencies sources to.
node_modules/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Local beads telemetry churn; the tracker syncs through its own Dolt remote
# (`sync.remote` in `.beads/config.yaml`), not through this git repository.
.beads/interactions.jsonl

# Changelog fragments are tracked. A global gitignore rule for `*.d` (C/C++
# dependency files) matches this directory name and would otherwise hide them.
!changelog.d/

# Coverage output, written by the gate's `vitest run --coverage`.
coverage/

# The generated API reference, built by `pnpm run docs` (typedoc.json). It is
# built locally and checked by the gate, and never committed.
/docs/api/

# The wurk kit's detached gate runner writes its run directory here when it is
# given no run directory. Biome honours this file, so without the rule the gate
# lints the files its own run wrote.
/.claude/wurk-runs/

# A packed tarball of this package, written to the checkout root by `npm pack`
# or `pnpm pack`. It is a build artefact and must never be committed.
/uxid-*.tgz
